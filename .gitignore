# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/
.pytest_cache/
.coverage
htmlcov/

# 工具/临时
.tmp/
*.bak
~$*.xlsx

# 根目录上一次 render 的临时产物（示例产物 examples/ 与 abs_fpi/ 是刻意保留的）
/template.xlsx
/template_formula.xlsx
/generated/
/generated_formula/

# abs_fpi/probes：探针工作簿是每次跑 run_probes.py 重新生成的中间产物
# （探针的 YAML、脚本与 _probe_run.txt 是证据，保留）
abs_fpi/probes/*.xlsx
abs_fpi/probes/_out/

# abs_fpi 的一键刷新脚本：由 init / build.py --init 就地生成，每次内容一样
# （examples/ 下那两个是刻意保留下来当样板的）
abs_fpi/*_render.sh
abs_fpi/*_render.bat

# --------------------------------------------------------------------------- #
# 密钥与凭据 —— 本仓库是**公开**的，下面这些东西永远不要提交。
# 这一层只是兜底；真正的守门人是 GitHub 的 push protection（见 docs/publishing.md）。
# --------------------------------------------------------------------------- #
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.jks
secrets.*
credentials.*
*credentials*.json
*service-account*.json
.aws/
.gcp/
.ssh/
id_rsa*
id_ed25519*
*.code-workspace
.vscode/settings.json

# 大模型 / 云服务的本地配置（各家 CLI 常把 key 落在这里）
.anthropic/
.openai/
.config/openai/
.dsh/
