# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/
.pytest_cache/
.coverage
htmlcov/

# 工具/临时
.tmp/
*.bak
~$*.xlsx

# pytest 的临时目录。正常情况它在系统临时区（%TEMP% / /tmp），但若环境里
# tempfile.gettempdir() 不可写（受限制的 shell、沙箱等），pytest 会退到**当前目录**，
# 于是仓库根目录多出 pytest-of-<用户名>/。那是测试残留，永远不该提交。
pytest-of-*/

# 根目录上一次 render 的临时产物（内置示例 spreadsheet_codegen/examples/ 是刻意保留的）
/template.xlsx
/template_formula.xlsx
/generated/
/generated_formula/

# abs_fpi/probes：探针工作簿是每次跑 run_probes.py 重新生成的中间产物
# （探针的 YAML、脚本与 _probe_run.txt 是证据，保留）
abs_fpi/probes/*.xlsx
abs_fpi/probes/_out/

# abs_fpi 现场目录的一次性产物：渲染脚本按示例资产生成，产物落在
# spreadsheet_codegen/examples/abs_fpi/（那边的是刻意保留的样板，不忽略）
abs_fpi/**/*_render.sh
abs_fpi/**/*_render.bat

# --------------------------------------------------------------------------- #
# 密钥与凭据 —— 本仓库是**公开**的，下面这些东西永远不要提交。
# 这一层只是兜底；真正的守门人是 GitHub 的 push protection（见 docs/publishing.md）。
# --------------------------------------------------------------------------- #
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.jks
secrets.*
credentials.*
*credentials*.json
*service-account*.json
.aws/
.gcp/
.ssh/
id_rsa*
id_ed25519*
*.code-workspace
.vscode/settings.json

# 大模型 / 云服务的本地配置（各家 CLI 常把 key 落在这里）
.anthropic/
.openai/
.config/openai/
.dsh/
